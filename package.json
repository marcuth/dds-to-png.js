    "@types/pngjs": "^6.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dds-parser": "^1.0.1",
    "pngjs": "^7.0.0"
  }
}
